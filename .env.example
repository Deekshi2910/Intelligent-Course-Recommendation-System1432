# ==============================================================================
# Intelligent Course Recommendation System (CourseRecommender AI)
# Environment Configuration Template (.env.example)
# Duplicate this file as .env and fill in your local or production credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Flask Core Settings
# ------------------------------------------------------------------------------
FLASK_APP=app.py
# Set to 'development' for local work, or 'production' for live deployment
FLASK_ENV=development
# Set to 1 for hot reloading locally; always 0 in production
FLASK_DEBUG=1
# Secret key used for session signing and CSRF tokens (generate a 32+ byte random string)
SECRET_KEY=replace_with_a_secure_random_secret_key_32_characters_minimum

# Host and Port binding (Render dynamically sets PORT in production)
HOST=0.0.0.0
PORT=5000

# ------------------------------------------------------------------------------
# 2. Database Configuration (Option A: Local MySQL Server)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=intelligent_course_recommendation
DB_USER=root
DB_PASSWORD=your_local_mysql_password

# ------------------------------------------------------------------------------
# 3. Database Configuration (Option B: TiDB Cloud Starter / Serverless)
# ------------------------------------------------------------------------------
# In TiDB Cloud Console -> Clusters -> Connect:
# Copy host, user (e.g., xxxxxx.root), port (4000), and generated password.
TIDB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_NAME=intelligent_course_recommendation
TIDB_USER=your_tidb_username_prefix.root
TIDB_PASSWORD=your_tidb_password

# ------------------------------------------------------------------------------
# 4. Alternative: Single DATABASE_URL (Supported on Render / Heroku)
# ------------------------------------------------------------------------------
# DATABASE_URL=mysql://username:password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/intelligent_course_recommendation

# ------------------------------------------------------------------------------
# 5. SSL / TLS Database Configuration
# ------------------------------------------------------------------------------
# Modes: AUTO (default: enables SSL for TiDB Cloud/remote hosts; disables for localhost)
#        REQUIRED (forces SSL on all connections)
#        DISABLED (disables SSL, use only for local MySQL)
DB_SSL_MODE=AUTO
DB_SSL_VERIFY_CERT=1
DB_SSL_VERIFY_IDENTITY=1
# Optional: path to custom CA certificate if not using system root certificates
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
